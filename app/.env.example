# Frontend API base path (defaults to Vite proxy /api in development)
VITE_API_URL=/api

# Firebase web app configuration (public identifiers, NOT service-account secrets).
# Copy these from Firebase Console > Project settings > Your apps > Web app.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Realtime WebSocket relay URL
# Leave this UNSET for automatic Wi-Fi-independent behavior:
#   wss://<browser's hostname>:1234  (derived from window.location.hostname at runtime)
# Only set this if you need to override the automatic URL, e.g. for a fixed server:
# VITE_REALTIME_URL=wss://your-server-hostname:1234

# WebRTC ICE server configuration (STUN & TURN)
# STUN defaults to Google's public STUN server if unset:
# VITE_STUN_URL=stun:stun.l.google.com:19302
# Optional TURN server for restrictive networks / symmetric NAT traversal:
# VITE_TURN_URL=turn:your-turn-server.example.com:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential
